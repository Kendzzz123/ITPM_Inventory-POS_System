{
  "expo": {
    "name": "Mr. Liempo",
    "slug": "mr-liempo-pos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "mobileapp",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFC400",
        "foregroundImage": "./assets/images/app-icon-foreground.png",
        "monochromeImage": "./assets/images/app-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.mrliempo.pos",
      "versionCode": 1
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFC400",
          "image": "./assets/images/logo.png",
          "imageWidth": 220
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-sharing",
      "./plugins/withCleartextTraffic"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "4aed318b-88f5-4972-838a-6e23f14216a0"
      }
    }
  }
}
