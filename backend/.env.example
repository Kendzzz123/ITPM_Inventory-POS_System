# Copy this file to .env and fill in your own values. Never commit .env.
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=myapp_db

# Use a long random string (e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Gmail address + 16-character Gmail App Password (used to email password-reset codes)
EMAIL_USER=
EMAIL_PASS=

# Password(s) given to new staff accounts; logging in with one forces a password change
DEFAULT_STAFF_PASSWORDS=Mr.liempo123,password123

# Optional: first manager account created by `npm run db:seed`
SEED_MANAGER_NAME=Store Manager
SEED_MANAGER_USERNAME=manager
SEED_MANAGER_EMAIL=

# --- Security (optional; sensible defaults are used if left unset) ---
# Allowed browser origins for CORS, comma separated. Leave empty to allow any
# origin (a phone app sends no Origin header, so this only matters for websites).
CORS_ORIGINS=
# Brute-force limits per IP: max login/OTP-verify attempts per window (minutes).
LOGIN_RATE_MAX=20
LOGIN_RATE_WINDOW_MIN=15
# Max password-reset emails per IP per window.
OTP_REQUEST_RATE_MAX=5
OTP_REQUEST_RATE_WINDOW_MIN=15
# Password hashing strength (bcrypt rounds). 12 is a good default.
BCRYPT_ROUNDS=12
# Set to "production" on the live server to hide stack traces from logs.
NODE_ENV=development
